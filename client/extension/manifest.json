{
    "manifest_version": 3,
    "name": "KivoAI",
    "version": "0.1.0",
    "description": "Privacy-preserving browser AI agent",

    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "optional_host_permissions": [
        "https://*/*"
    ],

    "action": {
        "default_popup": "popup.html"
    }
}
